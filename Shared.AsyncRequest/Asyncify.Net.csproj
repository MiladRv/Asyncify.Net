<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>12</LangVersion>
		<AssemblyName>Green.CT.$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>Green.CT.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
		<TargetFramework>net8.0</TargetFramework>

		<!-- Package identity -->
		<PackageId>MiladRv.Asyncify.Net</PackageId>
		<Title>MiladRv.Asyncify.Net</Title>
		<Authors>MiladRv</Authors>
		<Description>Run heavy synchronous ASP.NET Core controller actions in the background without changing your business logic. Add an attribute, get a trackId instantly, and poll for the result.</Description>
		<PackageTags>aspnetcore;async;background;middleware;polling;fire-and-forget;dotnet</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/MiladRv/Asyncify.Net</PackageProjectUrl>
		<RepositoryUrl>https://github.com/MiladRv/Asyncify.Net</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<ItemGroup>
		<!-- README رو داخل package قرار میده تا توی nuget.org نمایش داده بشه -->
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.App" Version="2.2.8" />
		<PackageReference Include="Microsoft.AspNetCore.Routing" Version="2.2.2" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.3" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
		<PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="6.5.0" />
	</ItemGroup>

</Project>
