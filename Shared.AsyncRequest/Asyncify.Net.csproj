<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>12</LangVersion>
		<AssemblyName>Green.CT.$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>Green.CT.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
		<TargetFramework>net8.0</TargetFramework>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Title>Asyncify.Net</Title>
		<Authors>Green.CT</Authors>
		<Description>This projects helps to handle rest-requests asyncronize.</Description>
		<RepositoryUrl>https://github.com/green-ct/Asyncify.Net</RepositoryUrl>
		<PackageTags>1.0.0</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.App" Version="2.2.8" />
		<PackageReference Include="Microsoft.AspNetCore.Routing" Version="2.2.2" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.3" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
		<PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="6.5.0" />
	</ItemGroup>

</Project>
