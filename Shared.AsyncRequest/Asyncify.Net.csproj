<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>12</LangVersion>
		<AssemblyName>Green.CT.$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>Green.CT.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>

		<!-- Package identity -->
		<PackageId>MiladRv.Asyncify.Net</PackageId>
		<Title>MiladRv.Asyncify.Net</Title>
		<Authors>MiladRv</Authors>
		<Description>Run heavy synchronous ASP.NET Core controller actions in the background without changing your business logic. Add an attribute, get a trackId instantly, and poll for the result.</Description>
		<PackageTags>aspnetcore;async;background;middleware;polling;fire-and-forget;dotnet</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/MiladRv/Asyncify.Net</PackageProjectUrl>
		<RepositoryUrl>https://github.com/MiladRv/Asyncify.Net</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<ItemGroup>
		<!-- README رو داخل package قرار میده تا توی nuget.org نمایش داده بشه -->
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<!-- Microsoft.AspNetCore.App و Routing به عنوان PackageReference منسوخ شدن از .NET 3+
		     برای library ها باید از FrameworkReference استفاده بشه -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<!-- OpenApi نسخه متفاوتی برای هر framework داره -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.19" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
		<PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="10.1.7" />
	</ItemGroup>

</Project>
